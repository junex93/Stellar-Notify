# Stellar identity alias (Stellar CLI keystore) — never a secret key
CAATINGA_SOURCE=notify-dev
# Listener
DATABASE_URL=postgresql://notify:notify@localhost:5433/notify
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Written by `ctg sync-env` from caatinga.artifacts.json — do not copy IDs by hand
# NOTIFY_CHANNELS_CONTRACT_ID=
# Optional: first ledger to read when no cursor is stored (default: current tip)
# START_LEDGER=
POLL_INTERVAL_MS=5000

# Telegram bot token (from @BotFather). Env only: never stored in the database.
# TELEGRAM_BOT_TOKEN=
